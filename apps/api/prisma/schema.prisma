generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Panel ───────────────────────────────────────────────────────────────────

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("users")
}

/// Configuración del negocio. Hay una única fila (id = 1).
model Settings {
  id            Int     @id @default(1)
  businessName  String  @default("Papelera Isene")
  /// Tasa de IVA para productos que discriminan (0.21 = 21%)
  ivaRate       Decimal @default(0.21) @db.Decimal(5, 4)
  /// Texto con los datos para transferir (alias, CBU, titular) que el bot le pasa al cliente
  transferInfo  String  @default("")
  pickupAddress String  @default("")
  /// Compra mínima para envío (0 = sin mínimo)
  minOrderForDelivery Decimal @default(0) @db.Decimal(12, 2)

  @@map("settings")
}

// ─── Catálogo ────────────────────────────────────────────────────────────────

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  sortOrder Int       @default(0)
  products  Product[]

  @@map("categories")
}

model Product {
  id            Int         @id @default(autoincrement())
  /// Código corto que el cliente usa para pedir por WhatsApp (ej. R-A4)
  code          String      @unique
  name          String
  /// Presentación: unidad, caja x 50, resma x 500...
  unit          String      @default("unidad")
  /// Precio en efectivo. Si discriminaIva = true, es el precio SIN IVA.
  price         Decimal     @db.Decimal(12, 2)
  /// true: en transferencia se suma el IVA. false: mismo precio en efectivo y transferencia.
  discriminaIva Boolean     @default(false)
  /// Precio de transferencia fijo. Si está cargado, pisa el cálculo con IVA.
  priceTransfer Decimal?    @db.Decimal(12, 2)
  active        Boolean     @default(true)
  /// Marcado para revisar (precio dudoso, sin precio, etc.)
  needsReview   Boolean     @default(false)
  reviewNote    String?
  categoryId         Int?
  category           Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems         OrderItem[]
  purchaseOrderItems PurchaseOrderItem[]
  invoiceSaleItems   InvoiceSaleItem[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([categoryId])
  @@index([needsReview])
  @@map("products")
}

// ─── Pedidos ─────────────────────────────────────────────────────────────────

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
}

enum DeliveryMethod {
  RETIRO
  ENVIO
}

enum OrderStatus {
  PENDIENTE_REVISION
  ESPERANDO_CLIENTE
  CONFIRMADO
  PROGRAMADO
  ENTREGADO
  CANCELADO
}

enum ItemStatus {
  PENDIENTE
  DISPONIBLE
  /// Hay menos de lo pedido: ver availableQuantity
  PARCIAL
  FALTANTE
}

/// Lo decide el dueño al revisar un pedido con envío
enum OrderSource {
  WHATSAPP
  WEB
}

enum ShippingStatus {
  PENDIENTE
  GRATIS
  CON_COSTO
  /// No llegan con envío a esa zona: el pedido pasa a retiro (el cliente tiene que aceptar)
  FUERA_ZONA
}

enum PaymentStatus {
  PENDIENTE
  COMPROBANTE_RECIBIDO
  PAGADO
}

model Customer {
  id        Int      @id @default(autoincrement())
  /// Teléfono en formato internacional sin "+" (ej. 5491122334455). Es la identidad en WhatsApp.
  phone     String   @unique
  name      String?
  address   String?
  /// Último mensaje que nos mandó por WhatsApp: define si estamos dentro de la ventana de 24 h
  lastInboundAt DateTime?
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customers")
}

model Order {
  id              Int             @id @default(autoincrement())
  customerId      Int
  customer        Customer        @relation(fields: [customerId], references: [id])
  status          OrderStatus     @default(PENDIENTE_REVISION)
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus   @default(PENDIENTE)
  deliveryMethod  DeliveryMethod
  /// Dirección de envío (copia al momento del pedido)
  deliveryAddress String?
  /// Solo para pedidos con envío. null en los de retiro.
  shippingStatus  ShippingStatus?
  shippingCost    Decimal         @default(0) @db.Decimal(12, 2)
  /// Fecha en la que el pedido está listo para retirar o se envía
  scheduledFor    DateTime?
  /// Referencia al comprobante de transferencia (URL o id de media de WhatsApp)
  receiptRef      String?
  notes           String?
  /// Por dónde entró el pedido
  source          OrderSource     @default(WHATSAPP)
  /// Pedidos web: nombre que cargó el cliente (no pisa el del cliente hasta que confirme por WhatsApp)
  contactName     String?
  /// Pedidos web: código para vincular el pedido desde WhatsApp
  webCode         String?
  /// Pedidos web: cuándo el cliente confirmó desde su WhatsApp (null = todavía no)
  waConfirmedAt   DateTime?
  items           OrderItem[]
  messages        OutboundMessage[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status])
  @@index([customerId])
  @@map("orders")
}

model OrderItem {
  id          Int        @id @default(autoincrement())
  orderId     Int
  order       Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// null si el producto se eliminó después (el pedido conserva código, nombre y precio)
  productId   Int?
  product     Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// Copias al momento del pedido: si después cambia la lista, el pedido no se altera.
  productCode String
  productName String
  unitPrice   Decimal    @db.Decimal(12, 2)
  quantity    Int
  status      ItemStatus @default(PENDIENTE)
  /// Cantidad que hay cuando el ítem es PARCIAL
  availableQuantity Int?

  @@index([orderId])
  @@map("order_items")
}

enum MessageStatus {
  PENDING
  SENT
  FAILED
}

/// Mensajes que el bot tiene que mandarle al cliente (outbox).
/// La API los genera cuando cambia el pedido; el bot los levanta y los envía.
model OutboundMessage {
  id        Int           @id @default(autoincrement())
  orderId   Int?
  order     Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  phone     String
  body      String
  status    MessageStatus @default(PENDING)
  attempts  Int           @default(0)
  lastError String?
  createdAt DateTime      @default(now())
  sentAt    DateTime?

  @@index([status, createdAt])
  @@map("outbound_messages")
}

// ─── Bot de WhatsApp ─────────────────────────────────────────────────────────

/// Estado de la conversación del bot con cada teléfono.
model BotSession {
  phone     String   @id
  /// Paso actual del flujo (ver apps/api/src/bot/flow.ts)
  state     String   @default("IDLE")
  /// Datos parciales del pedido en curso (carrito, medio de pago, etc.)
  data      Json     @default("{}")
  /// Si el dueño respondió a mano desde la app, el bot no conversa hasta esta hora
  pausedUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("bot_sessions")
}

/// Ids de mensajes entrantes ya procesados (Meta reintenta los webhooks).
model InboundMessage {
  id         String   @id
  phone      String
  receivedAt DateTime @default(now())

  @@index([receivedAt])
  @@map("inbound_messages")
}

/// Número de WhatsApp conectado con Embedded Signup. Hay una sola fila (id = 1).
/// Si no existe, el bot usa las variables WHATSAPP_TOKEN / WHATSAPP_PHONE_NUMBER_ID.
model WhatsappConnection {
  id            Int      @id @default(1)
  wabaId        String
  phoneNumberId String
  displayPhone  String?
  verifiedName  String?
  /// Token del usuario del sistema de la integración, cifrado (AES-256-GCM)
  tokenEnc      String
  /// Conectado en modo coexistencia (sigue usándose la app WhatsApp Business)
  coexistence   Boolean  @default(true)
  connectedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("whatsapp_connection")
}

// ─── Proveedores (listas de faltantes) ───────────────────────────────────────

model Supplier {
  id          Int      @id @default(autoincrement())
  /// Razón social
  legalName   String
  email       String?
  /// Teléfono de contacto, como lo cargaron (el link de WhatsApp se arma al compartir)
  phone       String?
  contactName String?
  orders      PurchaseOrder[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("suppliers")
}

enum PurchaseOrderStatus {
  PENDIENTE
  PEDIDO
  RECIBIDO
}

/// Lista de artículos a encargar. Puede quedar sin proveedor.
model PurchaseOrder {
  id         Int                  @id @default(autoincrement())
  supplierId Int?
  supplier   Supplier?            @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  status     PurchaseOrderStatus  @default(PENDIENTE)
  notes      String?
  items      PurchaseOrderItem[]
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([supplierId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id          Int           @id @default(autoincrement())
  orderId     Int
  order       PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// null si el producto se eliminó después (la lista conserva código y nombre)
  productId   Int?
  product     Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  productCode String
  productName String
  unit        String        @default("unidad")
  quantity    Int

  @@index([orderId])
  @@map("purchase_order_items")
}

// ─── Ventas a facturar ───────────────────────────────────────────────────────

enum InvoiceSaleStatus {
  PENDIENTE
  FACTURADA
}

/// Anotación de una venta (típicamente una transferencia) para facturar después.
/// No se conecta con AFIP: es la lista de lo que falta facturar.
model InvoiceSale {
  id           Int               @id @default(autoincrement())
  status       InvoiceSaleStatus @default(PENDIENTE)
  customerName String?
  customerCuit String?
  note         String?
  /// Total a facturar. Arranca como la suma de los ítems y se puede ajustar.
  total        Decimal           @db.Decimal(12, 2)
  invoicedAt   DateTime?
  items        InvoiceSaleItem[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([status, createdAt])
  @@map("invoice_sales")
}

model InvoiceSaleItem {
  id          Int         @id @default(autoincrement())
  saleId      Int
  sale        InvoiceSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   Int?
  product     Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  productCode String
  productName String
  unit        String      @default("unidad")
  unitPrice   Decimal     @db.Decimal(12, 2)
  quantity    Int

  @@index([saleId])
  @@map("invoice_sale_items")
}
