# Postgres local (pnpm db:up). Usa el puerto 5433 para no chocar con otro Postgres en 5432
DATABASE_URL="postgresql://papelera:papelera@localhost:5433/papelera"

PORT=3100
# Origen del panel web (para CORS)
WEB_ORIGIN="http://localhost:5173"

# Firmar los tokens del panel. Generalo con: openssl rand -hex 32
JWT_SECRET="cambiame-por-algo-largo-y-aleatorio"
JWT_EXPIRES_IN="7d"

# El bot se autentica con este header: x-bot-key
BOT_API_KEY="cambiame-tambien"

# Usuario inicial del panel (lo crea el seed)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="cambiame-al-primer-login"

# URL pública (para los links que manda el bot). En Railway no hace falta: usa RAILWAY_PUBLIC_DOMAIN.
PUBLIC_URL=

# WhatsApp Cloud API (developers.facebook.com → tu app → WhatsApp → API Setup).
# Si están vacías, el bot queda apagado y el panel funciona igual.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Lo inventás vos (openssl rand -hex 16) y lo pegás también en Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=
# App settings → Basic → App secret (valida que los webhooks vengan de Meta)
WHATSAPP_APP_SECRET=

# Botón "Conectar WhatsApp" (Embedded Signup en modo coexistencia)
# META_APP_ID: Configuración de la app → Básica → Identificador de la app
META_APP_ID=
# META_CONFIG_ID: Facebook Login for Business → Configuraciones → la de WhatsApp Embedded Signup
META_CONFIG_ID=
# Opcional: clave para cifrar el token guardado. Si falta, se deriva de JWT_SECRET
# (si cambiás JWT_SECRET hay que volver a conectar WhatsApp).
TOKEN_ENCRYPTION_KEY=
# Minutos que el bot se calla en un chat cuando el dueño responde a mano desde la app
WHATSAPP_HUMAN_PAUSE_MINUTES=240
