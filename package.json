{
  "name": "papelera-isene",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @papelera/api db:migrate",
    "db:seed": "pnpm --filter @papelera/api db:seed",
    "db:studio": "pnpm --filter @papelera/api db:studio",
    "dev": "pnpm -r --parallel --filter @papelera/api --filter @papelera/web dev",
    "dev:api": "pnpm --filter @papelera/api dev",
    "dev:web": "pnpm --filter @papelera/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  }
}
